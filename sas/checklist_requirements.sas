/*======================================================================
  STAT 3660SEF: complete implementation of the ten assessment items.

  Run from the repository root in a UTF-8 SAS 9.4 / SAS Studio session.
  Requires Base SAS, SAS/STAT, ODS Graphics, and an XLSX-capable installation.
  No R, Python, or Excel analysis is used.

  The Excel lookup and fixed-width text file are generated by SAS from the
  existing CSV, then read back. They add columns, not extra observations.
  The small problematic-file example is an IO test only.

  All files generated by this program stay under output/checklist/.
  See docs/CHECKLIST.md for the requirement-to-code mapping and limitations.
======================================================================*/

options validvarname=v7 dlcreatedir;
ods graphics on;

/* A caller may set project_dir before submitting this file. In SAS Studio,
   use the server-side repository folder, not a local Windows path. */
%macro set_checklist_paths;
    %global checklist_input checklist_output;
    %if not %symexist(project_dir) %then %do;
        %global project_dir;
        %let project_dir=.;
    %end;
    %if %length(%superq(project_dir))=0 %then %let project_dir=.;
    filename projroot "&project_dir";
    %let project_dir=%sysfunc(pathname(projroot));
    filename projroot clear;
    %let checklist_input=&project_dir./data/intern_data.csv;
    libname ckparent "&project_dir./output";
    %let checklist_output=&project_dir./output/checklist;
    libname ckout "&checklist_output";
    libname ckparent clear;
%mend set_checklist_paths;
%set_checklist_paths;

/* Reusable checks stop the run before a bad join or failed file import
   can produce misleading output. */
%macro ck_assert(name=, condition=);
    %if not (&condition) %then %do;
        %put ERROR: CHECKLIST CHECK FAILED: &name;
        %abort cancel;
    %end;
    %put NOTE: CHECKLIST CHECK PASSED: &name;
%mend ck_assert;

%macro run_checklist;
    %local input_n csv_n raw_n lookup_n output_n issue_n unmatched_n
           distinct_ids duplicate_keys long_fail_n limit_n
           n_known n_yes n_no n_disclosed n_notdisclosed
           top_n bottom_n nonmissing_n problem_n short_fail_n;

    %ck_assert(name=Input CSV exists,
               condition=%sysfunc(fileexist(%superq(checklist_input)))=1);
    %ck_assert(name=Output library is writable,
               condition=%sysfunc(libref(ckout))=0);

    /* [01] READ THREE DIFFERENT FILE FORMATS: part A, delimited CSV.
       PROC IMPORT is included as required. The explicit DATA-step reader
       below is the analysis reader because it controls every field type
       and length rather than relying on import guesses. */
    proc import datafile="&checklist_input"
        out=work.ck_csv_inferred dbms=csv replace;
        getnames=yes;
        guessingrows=max;
    run;
    %ck_assert(name=PROC IMPORT CSV succeeded,
               condition=%sysfunc(exist(work.ck_csv_inferred))=1);

    /* [02] PROBLEMATIC FILES and [03] CHARACTER / NUMERIC / DATE TYPES.
       DSD handles quoted commas and empty fields. TRUNCOVER prevents a
       short record from consuming values from the following record.
       LRECL and explicit character lengths preserve long text.
       The input column order is the committed CSV's 20-column schema. */
    filename ckcsv "&checklist_input" encoding="utf-8";
    data work.ck_typed_csv;
        length Year_Raw $20 Sector $40 Industry $100 Company $512
               Position Location Source_URL $8192 Paid $40
               Stipend_Raw $100 Collection_Date_Raw Posting_Date_Raw $40
               Num_Positions_Raw $40 Record_ID $128 Year_Basis $40
               Program_Year $100 Listing_Status $40 Data_Source $160
               Salary_Text $1024 Source_Repository $512 Season $40;
        infile ckcsv dsd dlm=',' firstobs=2 truncover lrecl=1048576;
        input Year_Raw :$20. Sector :$40. Industry :$100.
              Company :$512. Position :$8192. Paid :$40.
              Stipend_Raw :$100. Location :$8192.
              Collection_Date_Raw :$40. Num_Positions_Raw :$40.
              Record_ID :$128. Posting_Date_Raw :$40. Year_Basis :$40.
              Program_Year :$100. Listing_Status :$40. Data_Source :$160.
              Salary_Text :$1024. Source_URL :$8192.
              Source_Repository :$512. Season :$40.;
        Listing_Row_ID = _n_;

        /* Convert typed values; preserve original strings for auditing. */
        Year = input(strip(Year_Raw), ?? best32.);
        Stipend = input(compress(Stipend_Raw, ','), ?? best32.);
        Num_Positions = input(strip(Num_Positions_Raw), ?? best32.);
        Collection_Date = input(strip(Collection_Date_Raw), ?? yymmdd10.);
        Posting_Date = input(strip(Posting_Date_Raw), ?? yymmdd10.);
        format Year 4. Collection_Date Posting_Date yymmdd10.
               Stipend comma12.2;
    run;
    filename ckcsv clear;

    /* [02] Record-level audit: a missing amount remains missing.
       Long text is retained; a value at its buffer limit is investigated. */
    data work.ck_clean(drop=Issue) ckout.input_issues;
        length Source_Key $160 Issue $80 Paid_Status $10;
        set work.ck_typed_csv;

        if missing(Year) or Year ne int(Year) or
           Year < 2016 or Year > 2026 then do;
            Issue='Invalid or out-of-scope listing year';
            output ckout.input_issues;
            delete;
        end;
        if not missing(Stipend_Raw) and
           (missing(Stipend) or Stipend < 0) then do;
            Issue='Stipend could not be parsed as a nonnegative amount';
            output ckout.input_issues;
            Stipend=.;
        end;
        if not missing(Num_Positions_Raw) and
           (missing(Num_Positions) or Num_Positions <= 0 or
            Num_Positions ne int(Num_Positions)) then do;
            Issue='Invalid number of positions';
            output ckout.input_issues;
            Num_Positions=.;
        end;
        if (not missing(Collection_Date_Raw) and missing(Collection_Date)) or
           (not missing(Posting_Date_Raw) and missing(Posting_Date)) then do;
            Issue='Unrecognised ISO date';
            output ckout.input_issues;
        end;

        Sector=strip(Sector);
        Industry=strip(Industry);
        Company=strip(Company);
        Position=strip(Position);
        if missing(Sector) then Sector='Other/Unclassified';
        if missing(Industry) then Industry='Other/Unclassified';
        if missing(Company) then Company='Unknown';
        if missing(Data_Source) then Data_Source='Unknown';
        Source_Key=upcase(strip(Data_Source));

        /* [08] CONDITIONAL STATEMENTS: unknown is never coded unpaid. */
        select (upcase(strip(Paid)));
            when ('PAID','YES','Y','1') Paid_Flag=1;
            when ('UNPAID','NO','N','0') Paid_Flag=0;
            otherwise Paid_Flag=.;
        end;
        if missing(Paid_Flag) and Stipend > 0 then Paid_Flag=1;
        if Paid_Flag=1 then Paid_Status='Paid';
        else if Paid_Flag=0 then Paid_Status='Unpaid';
        else Paid_Status='Unknown';

        Compensation_Known=not missing(Paid_Flag);
        Large_Private_Flag=(Sector in ('Large Chain','Large Group'));
        Year_Centered=Year-2026;
        Posting_Count=1;
        Position_Chars=klength(Position);
        Position_Bytes=lengthn(Position);
        URL_Bytes=lengthn(Source_URL);
        Location_Chars=klength(Location);
        Stipend_Missing=missing(Stipend);
        Positions_Missing=missing(Num_Positions);
        Long_Location=(Location_Chars > 200);
        At_Field_Limit=(lengthn(Position)>=8192 or lengthn(Location)>=8192 or
                        lengthn(Source_URL)>=8192 or lengthn(Company)>=512);

        /* Stipends are not normalised unless the amount, currency and
           payment period are documented. Do not compare mixed units. */
        output work.ck_clean;
    run;

    proc sql noprint;
        select count(*) into :input_n trimmed from work.ck_typed_csv;
        select count(*) into :csv_n trimmed from work.ck_csv_inferred;
        select count(*) into :output_n trimmed from work.ck_clean;
        select count(*) into :limit_n trimmed
            from work.ck_clean where At_Field_Limit=1;
    quit;
    %ck_assert(name=CSV readers have the same record count,
               condition=&input_n=&csv_n);
    %ck_assert(name=Analysis input contains records, condition=&output_n>0);
    %ck_assert(name=No potential text buffer truncation, condition=&limit_n=0);

    /* [01] part B, Excel XLSX. Create a source-label lookup with one row
       per source, export it, then actually read the Excel file.
       These metadata come from source labels, not independent validation. */
    data work.ck_source_seed;
        length Source_Name $160 Source_Group $24;
        set work.ck_clean(keep=Source_Key Data_Source);
        Source_Name=Data_Source;
        if index(Source_Key,'WORKOPIA') > 0 then Source_Group='Workopia';
        else if index(Source_Key,'JOBSPY') > 0 then Source_Group='JobSpy';
        else if index(Source_Key,'FREEHIRE') > 0 then Source_Group='FreeHire';
        else Source_Group='Other source';
        keep Source_Key Source_Name Source_Group;
    run;
    proc sort data=work.ck_source_seed nodupkey;
        by Source_Key;
    run;
    proc export data=work.ck_source_seed
        outfile="&checklist_output./source_lookup.xlsx" dbms=xlsx replace;
        sheet="Sources";
    run;
    proc import datafile="&checklist_output./source_lookup.xlsx"
        out=work.ck_excel_lookup dbms=xlsx replace;
        sheet="Sources";
        getnames=yes;
    run;
    %ck_assert(name=Excel file was read,
               condition=%sysfunc(exist(work.ck_excel_lookup))=1);

    /* [01] part C, fixed-width raw text. Write only derived numeric/date
       columns, so no unicode text is cut at a byte boundary. */
    filename ckraw "&checklist_output./record_metadata.txt" encoding="utf-8";
    data _null_;
        set work.ck_clean;
        file ckraw lrecl=80;
        put @1 Listing_Row_ID z8.
            @10 Year 4.
            @15 Position_Bytes 5.
            @21 URL_Bytes 5.
            @27 Collection_Date yymmdd10.;
    run;
    data work.ck_raw_metadata;
        infile ckraw truncover lrecl=80;
        input @1 Listing_Row_ID 8.
              @10 Raw_Listing_Year 4.
              @15 Raw_Position_Bytes 5.
              @21 Raw_URL_Bytes 5.
              @27 Raw_Collection_Date yymmdd10.;
        format Raw_Collection_Date yymmdd10.;
    run;
    filename ckraw clear;

    /* [02] A real long location string and a deliberately short IO test
       line. This example never enters the market analysis dataset.
       The second line omits its numeric/date fields to test TRUNCOVER. */
    proc sort data=work.ck_clean out=work.ck_long_locations;
        by descending Location_Chars Listing_Row_ID;
    run;
    filename ckprob "&checklist_output./problematic_records.txt"
        encoding="utf-8";
    data _null_;
        set work.ck_long_locations(obs=2);
        file ckprob dsd dlm='|' lrecl=32767;
        if _n_=1 then
            put Listing_Row_ID Location Stipend_Raw Collection_Date_Raw;
        else put Listing_Row_ID Location;
    run;
    data ckout.problematic_read;
        length Demo_Text $8192 Demo_Amount_Raw $100 Demo_Date_Raw $40;
        infile ckprob dsd dlm='|' truncover lrecl=32767;
        input Listing_Row_ID Demo_Text :$8192.
              Demo_Amount_Raw :$100. Demo_Date_Raw :$40.;
        Demo_Amount=input(strip(Demo_Amount_Raw), ?? best32.);
        Demo_Date=input(strip(Demo_Date_Raw), ?? yymmdd10.);
        Demo_Row=_n_;
        Text_Characters=klength(Demo_Text);
        Text_Over_200=(Text_Characters>200);
        Amount_Missing=missing(Demo_Amount);
        Date_Missing=missing(Demo_Date);
        format Demo_Date yymmdd10.;
        label Demo_Text='Preserved full location text'
              Text_Characters='Characters read'
              Amount_Missing='Missing amount retained';
    run;
    filename ckprob clear;
    proc sql noprint;
        select count(*) into :problem_n trimmed from ckout.problematic_read;
        select count(*) into :short_fail_n trimmed
            from ckout.problematic_read
            where Demo_Row=2 and
                  (not missing(Demo_Amount) or not missing(Demo_Date));
        select count(*) into :long_fail_n trimmed
        from ckout.problematic_read as p
        inner join work.ck_clean as c on p.Listing_Row_ID=c.Listing_Row_ID
        where p.Demo_Text ne c.Location;
    quit;
    %ck_assert(name=Problematic example preserved full text,
               condition=&long_fail_n=0);
    %ck_assert(name=Problematic example has the expected number of rows,
               condition=&problem_n=%sysfunc(min(2,&output_n)));
    %ck_assert(name=Short example retained missing values,
               condition=&short_fail_n=0);

    /* [04] MERGE THE DATASETS: one-to-one raw metadata and many-to-one
       Excel source lookup. Check key uniqueness before the DATA MERGE. */
    proc sql noprint;
        select count(*), count(distinct Listing_Row_ID)
            into :raw_n trimmed, :distinct_ids trimmed
            from work.ck_raw_metadata;
        select count(*)-count(distinct Source_Key)
            into :duplicate_keys trimmed from work.ck_excel_lookup;
        select count(*) into :lookup_n trimmed from work.ck_source_seed;
    quit;
    %ck_assert(name=Raw metadata keys are unique,
               condition=&raw_n=&distinct_ids);
    %ck_assert(name=Raw metadata row count preserved,
               condition=&raw_n=&output_n);
    %ck_assert(name=Excel lookup keys are unique, condition=&duplicate_keys=0);

    proc sort data=work.ck_clean;
        by Listing_Row_ID;
    run;
    proc sort data=work.ck_raw_metadata;
        by Listing_Row_ID;
    run;
    data work.ck_joined_raw;
        merge work.ck_clean(in=from_csv)
              work.ck_raw_metadata(in=from_raw);
        by Listing_Row_ID;
        if from_csv;
        Raw_Matched=from_raw;
    run;
    proc sort data=work.ck_joined_raw;
        by Source_Key;
    run;
    proc sort data=work.ck_excel_lookup;
        by Source_Key;
    run;
    data ckout.checklist_analysis;
        merge work.ck_joined_raw(in=from_posting)
              work.ck_excel_lookup(in=from_source);
        by Source_Key;
        if from_posting;
        Excel_Matched=from_source;
        label Listing_Row_ID='Input row number'
              Company='Employer'
              Position='Internship position'
              Sector='Employer sector'
              Year='Listing year'
              Paid_Status='Reported pay status'
              Compensation_Known='Pay status disclosed (1=yes)'
              Position_Chars='Position title length (characters)'
              Source_Group='Source family'
              Source_URL='Original listing URL';
    run;
    proc sql noprint;
        select count(*) into :input_n trimmed from ckout.checklist_analysis;
        select count(*) into :unmatched_n trimmed
            from ckout.checklist_analysis
            where Raw_Matched=0 or Excel_Matched=0 or
                  Raw_Listing_Year ne Year or
                  Raw_Position_Bytes ne Position_Bytes or
                  Raw_URL_Bytes ne URL_Bytes or
                  Raw_Collection_Date ne Collection_Date;
    quit;
    %ck_assert(name=Both merges preserve the posting count,
               condition=&input_n=&output_n);
    %ck_assert(name=All joins match and raw fields round-trip,
               condition=&unmatched_n=0);

    /* [05] EXPORT THE CLEAN DATASET TO CSV. */
    proc export data=ckout.checklist_analysis
        outfile="&checklist_output./checklist_analysis.csv" dbms=csv replace;
        putnames=yes;
    run;

    ods html path="&checklist_output" (url=none) gpath="&checklist_output"
        body="checklist_report.html" style=HTMLBlue;
    ods graphics / reset=all width=10in height=5.5in
        imagefmt=png imagename="checklist";

    /* [06] FOUR LARGEST AND FOUR SMALLEST OBSERVATIONS.
       Count collected postings per recorded employer name, then select
       four employers per end. Missing stipends are never manufactured.
       Ties use the employer name. Employer aliases remain a limitation. */
    proc sql;
        create table ckout.company_postings as
        select Company, count(*) as Collected_Postings
            label='Collected postings for this employer name'
        from ckout.checklist_analysis
        where Company ne 'Unknown'
        group by Company;
    quit;
    proc sort data=ckout.company_postings
        out=work.ck_company_desc;
        by descending Collected_Postings Company;
    run;
    proc sort data=ckout.company_postings
        out=work.ck_company_asc;
        by Collected_Postings Company;
    run;
    data ckout.four_largest;
        length Extreme $12;
        set work.ck_company_desc(obs=4);
        Rank=_n_;
        Extreme='Largest';
        keep Extreme Rank Company Collected_Postings;
    run;
    data ckout.four_smallest;
        length Extreme $12;
        set work.ck_company_asc(obs=4);
        Rank=_n_;
        Extreme='Smallest';
        keep Extreme Rank Company Collected_Postings;
    run;

    /* [07] LIST DATA WITH HEADINGS AND COLUMN LABELS. */
    title1 "Checklist item 6: four largest and four smallest posting counts";
    title2 "Employer names as recorded; ties ordered by employer name";
    proc print data=ckout.four_largest label noobs;
        var Rank Company Collected_Postings;
    run;
    proc print data=ckout.four_smallest label noobs;
        var Rank Company Collected_Postings;
    run;
    title1 "Checklist item 7: labelled listing sample";
    title2 "The full analysis dataset is also exported as CSV";
    proc print data=ckout.checklist_analysis(obs=20) label noobs;
        var Listing_Row_ID Year Sector Company Position Paid_Status;
    run;
    title1 "Checklist items 2 and 3: long text and missing-field input";
    title2;
    proc print data=ckout.problematic_read label noobs;
    run;
    proc contents data=ckout.checklist_analysis varnum;
    run;

    /* [08] LOOP: build a complete 2016-2026 coverage table.
       A zero here means no records collected, not no internships offered. */
    data work.ck_year_grid;
        do Year=2016 to 2026;
            output;
        end;
    run;
    proc sql;
        create table ckout.year_coverage as
        select y.Year, count(p.Listing_Row_ID) as Collected_Postings
        from work.ck_year_grid as y
        left join ckout.checklist_analysis as p on y.Year=p.Year
        group by y.Year order by y.Year;
    quit;

    /* [09] TWO DIFFERENT VISUALISATION TYPES: bar chart and histogram.
       A third, source-coverage time series, is descriptive only.
       Use the original program's five figures for the research report;
       this diagnostic program does not pretend to have complete history. */
    title1 "Checklist item 9A: collected internship postings by sector";
    footnote1 "Posting counts; source classifications require review.";
    proc sgplot data=ckout.checklist_analysis;
        vbar Sector / datalabel;
        xaxis label="Sector" fitpolicy=rotate;
        yaxis label="Collected postings" grid;
    run;
    title1 "Checklist item 9B: distribution of position title lengths";
    footnote1 "Text-quality diagnostic, measured in characters.";
    proc sgplot data=ckout.checklist_analysis;
        histogram Position_Chars;
        xaxis label="Position title length (characters)";
        yaxis label="Percent of collected postings" grid;
    run;
    title1 "Collection coverage by listing year";
    footnote1 "Missing coverage must not be interpreted as zero market supply.";
    proc sgplot data=ckout.year_coverage;
        series x=Year y=Collected_Postings / markers;
        xaxis values=(2016 to 2026 by 1) label="Listing year";
        yaxis label="Collected postings" grid;
    run;
    footnote;

    /* [10A] ANALYTICS TYPE 1: SUMMARY STATISTICS AND FREQUENCIES. */
    title1 "Checklist item 10A: descriptive statistics";
    proc means data=ckout.checklist_analysis n nmiss mean std
        min p25 median p75 max;
        class Sector;
        var Position_Chars Location_Chars Stipend Num_Positions;
    run;
    proc univariate data=ckout.checklist_analysis;
        var Position_Chars;
        id Listing_Row_ID;
    run;
    proc freq data=ckout.checklist_analysis;
        tables Year Sector Industry Paid_Status Year_Basis Season / missing;
    run;

    /* [10B] ANALYTICS TYPE 2: EXACT BINOMIAL INFERENCE.
       Estimate the paid fraction only among records with known pay status.
       Missing pay is excluded, not changed to zero. The reference 0.5 is
       an illustrative null, not a policy benchmark or a market estimate. */
    proc sql noprint;
        select count(*) into :n_known trimmed
            from ckout.checklist_analysis where Paid_Flag in (0,1);
        select count(*) into :n_yes trimmed
            from ckout.checklist_analysis where Paid_Flag=1;
        select count(*) into :n_no trimmed
            from ckout.checklist_analysis where Paid_Flag=0;
        select count(*) into :n_disclosed trimmed
            from ckout.checklist_analysis where Compensation_Known=1;
        select count(*) into :n_notdisclosed trimmed
            from ckout.checklist_analysis where Compensation_Known=0;
    quit;
    %if &n_yes>0 and &n_no>0 %then %do;
        title1 "Checklist item 10B: paid fraction among known-status records";
        title2 "Known-status N=&n_known; null paid proportion=0.5";
        proc freq data=ckout.checklist_analysis;
            where Paid_Flag in (0,1);
            tables Paid_Flag / binomial(p=0.5 level='1') alpha=0.05;
            exact binomial;
        run;
    %end;
    %else %do;
        %put NOTE: Exact paid-fraction example skipped: both outcomes needed.;
    %end;

    /* [10C] ANALYTICS TYPE 3: REGRESSION.
       Model disclosure rather than paid status, because the committed
       data have only one explicit unpaid record. Firth penalisation
       helps with sparse outcomes, but cannot remove selection bias.
       Only two predictors are used; inference remains exploratory. */
    %if &n_disclosed>=5 and &n_notdisclosed>=5 %then %do;
        title1 "Checklist item 10C: exploratory pay-disclosure regression";
        title2 "Outcome is known pay status, not whether the job is paid";
        proc logistic data=ckout.checklist_analysis;
            model Compensation_Known(event='1') =
                Large_Private_Flag Year_Centered / firth clodds=pl;
            output out=ckout.disclosure_predictions p=Disclosure_Probability;
        run;
    %end;
    %else %do;
        %put NOTE: Disclosure model skipped: too few records in an outcome.;
    %end;

    /* Run-time evidence: verify cardinality and extreme-row counts.
       The program does not claim every source is an independent vacancy. */
    proc sql noprint;
        select count(*) into :top_n trimmed from ckout.four_largest;
        select count(*) into :bottom_n trimmed from ckout.four_smallest;
        select count(*) into :nonmissing_n trimmed
            from ckout.company_postings;
        select count(*) into :issue_n trimmed from ckout.input_issues;
    quit;
    %ck_assert(name=Largest selection has up to four eligible rows,
               condition=&top_n=%sysfunc(min(4,&nonmissing_n)));
    %ck_assert(name=Smallest selection has up to four eligible rows,
               condition=&bottom_n=%sysfunc(min(4,&nonmissing_n)));

    data ckout.run_checks;
        length Check $70 Result $8;
        Check='CSV row count agrees with PROC IMPORT';
        Result='PASS'; output;
        Check='No potential long-text buffer truncation';
        Result='PASS'; output;
        Check='Excel and raw metadata keys are unique';
        Result='PASS'; output;
        Check='Metadata merges preserve listing count and field values';
        Result='PASS'; output;
        Check='Long-location IO example preserves the original text';
        Result='PASS'; output;
        Check='Four observations selected at each end when available';
        Result='PASS'; output;
    run;
    title1 "Checklist run checks";
    title2 "Review input_issues separately: &issue_n issue records";
    proc print data=ckout.run_checks noobs label;
    run;
    proc print data=ckout.year_coverage noobs label;
    run;
    ods html close;
    title;
    footnote;
    %put NOTE: Checklist complete. Output directory: &checklist_output;
%mend run_checklist;

%run_checklist;
ods graphics off;
